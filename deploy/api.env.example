# Copied to /etc/alive/api.env by deploy/install.sh. Keep the real file private.
ALIVE_WEB_ORIGIN=https://your-site.example
ALIVE_WEB_TOKEN=REPLACE_WITH_A_LONG_RANDOM_WEB_TOKEN
ALIVE_DEVICE_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_DEVICE_TOKEN
ALIVE_PUBLIC_DEMO=1
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY
# Optional single-visitor Wi-Fi gate. Calibrate this RSSI at the venue.
# ALIVE_PROXIMITY_RSSI_MIN=-65
